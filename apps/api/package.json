{
  "name": "@orbit/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "dev:edge": "tsx watch --clear-screen=false src/edge.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "start:edge": "node --disable-warning=ExperimentalWarning dist/edge.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:sandboxd": "tsx watch --clear-screen=false src/sandboxd.ts",
    "start:sandboxd": "node --disable-warning=ExperimentalWarning dist/sandboxd.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vercel/blob": "2.8.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
