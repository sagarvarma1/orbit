# Orbit's public entry point. Used by deploy/docker-compose.yml; values come from .env.
#
#   {$ORBIT_APP_DOMAIN}    dashboard + API on one origin
#   everything else        deployments, aliases and custom domains, served by the edge
#
# Certificates are issued on demand: the first HTTPS request for a hostname triggers one, after
# Orbit's API confirms it serves that hostname. No DNS provider credentials are needed.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://api:4000/api/tls/allowed
	}
}

{$ORBIT_APP_DOMAIN} {
	encode zstd gzip
	# Dashboard and API share an origin, so the session cookie never leaves it.
	handle /api/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy dashboard:3000
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy edge:8080
}

http:// {
	redir https://{host}{uri} permanent
}
