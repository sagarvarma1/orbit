# Copy to .env. Read by `pnpm dev` and by `docker compose`.

# Secret for GitHub webhooks (Settings -> Webhooks -> Secret). Leave empty to disable the endpoint.
GITHUB_WEBHOOK_SECRET=change-me

# Commit statuses + PR preview comments. A fine-grained token with "Commit statuses" and
# "Pull requests" read & write on the repos you deploy. Leave empty to disable.
GITHUB_TOKEN=
# Where "Inspect" links in GitHub point.
ORBIT_DASHBOARD_URL=http://localhost:3000

# Poll every branch of every project with `git ls-remote` and deploy new commits.
# Lets push-to-deploy work on a laptop where GitHub can't reach your webhook. 0 = off.
GIT_POLL_INTERVAL_SECONDS=10

# auto = Docker if the daemon is reachable, else child processes. Or force: docker | process
ORBIT_BUILDER=auto
# Reuse node_modules between builds when the lockfile is unchanged. 0 = off.
BUILD_CACHE=1
BUILD_CONCURRENCY=2
BUILD_TIMEOUT_SECONDS=600

# Deployments are served at <deployment-id>.<root> and <project>.<root>.
# `localhost` needs no DNS: browsers resolve *.localhost to 127.0.0.1.
ORBIT_ROOT_DOMAIN=localhost
ORBIT_PUBLIC_PROTOCOL=http
ORBIT_PUBLIC_EDGE_PORT=8080
