# Copy to .env. Read by `pnpm dev` and by `docker compose` (local). Production installs
# get their own .env from install.sh; see docs/self-hosting.md.

# Admin account. Leave empty to create it in the dashboard with the setup code the API prints.
ORBIT_ADMIN_EMAIL=
ORBIT_ADMIN_PASSWORD=

# Where the dashboard lives (CORS, cookies, GitHub App redirects, "Inspect" links on GitHub).
ORBIT_DASHBOARD_URL=http://localhost:3000

# GitHub: the recommended setup is Settings -> Create GitHub App in the dashboard.
# Alternatives: a repository webhook secret, and a fine-grained personal access token with
# "Commit statuses" and "Pull requests" read & write for statuses and PR comments.
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# Poll every branch of every project with `git ls-remote` and deploy new commits.
# Lets push-to-deploy work on a laptop where GitHub can't reach your webhook. 0 = off.
GIT_POLL_INTERVAL_SECONDS=10

# auto = Docker if the daemon is reachable, else child processes (localhost only). Or: docker | process
ORBIT_BUILDER=auto
# Reuse node_modules between builds when the lockfile is unchanged. 0 = off.
BUILD_CACHE=1
BUILD_CONCURRENCY=2
BUILD_TIMEOUT_SECONDS=600

# Deployments are served at <deployment-id>.<root> and <project>.<root>.
# `localhost` needs no DNS: browsers resolve *.localhost to 127.0.0.1.
ORBIT_ROOT_DOMAIN=localhost
ORBIT_PUBLIC_PROTOCOL=http
ORBIT_PUBLIC_EDGE_PORT=8080
