{
  "redirects": [{ "source": "/old-about", "destination": "/about" }],
  "rewrites": [{ "source": "/hello/:name", "destination": "/api/hello?name=:name" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Powered-By", "value": "Orbit" }
      ]
    }
  ]
}
